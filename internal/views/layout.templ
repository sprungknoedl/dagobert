package views

import (
	"github.com/sprungknoedl/dagobert/internal/model"
	"github.com/sprungknoedl/dagobert/pkg/fp"
)

templ layout() {
	<!DOCTYPE html>
	<html
		lang="en"
		if theme := themeFromContext(ctx); theme != "" {
			data-theme={ theme }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Dagobert</title>
			<link href="/public/assets/dagobert.css" rel="stylesheet"/>
			<script src="/public/assets/list-2.3.1.min.js" defer></script>
			<script src="/public/assets/choices-11.2.3.min.js" defer></script>
			<script src="/public/assets/vditor-3.11.2/dist/index.min.js" defer></script>
			<script src="/public/assets/unpoly-3.14.3.min.js"></script>
			<script src="/public/assets/dagobert.js"></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

// list is fullscreen's shell plus the navbar and #list conventions every
// record grid shares: the page title bar, the swappable #list container Unpoly
// targets on filter/sort, and (inside a case) the quick-add FAB.
templ list(env Env, title string, opts ...navbarOption) {
	@fullscreen(env, title) {
		@navbar(env, title, opts...)
		<div id="list">
			{ children... }
			<div class="mt-12"></div>
		</div>
		if env.Case.ID != "" && !env.Case.IsTemplate {
			// quick-add from any page in the case
			<div class="fab">
				<!-- a focusable div with tabindex is necessary to work on all browsers. role="button" is necessary for accessibility -->
				<div tabindex="0" role="button" class="btn btn-circle btn-primary" title="Quick add"><i class="ph ph-6 ph-plus"></i></div>
				<div class="fab-close">
					<span class="btn btn-circle"><i class="ph ph-6 ph-x"></i></span>
				</div>
				<!-- buttons that show up when FAB is open -->
				@fabButton("/cases/"+env.Case.ID+"/events", "ph-clock", "Add event")
				@fabButton("/cases/"+env.Case.ID+"/assets", "ph-desktop", "Add asset")
				@fabButton("/cases/"+env.Case.ID+"/indicators", "ph-fingerprint", "Add indicator")
				@fabButton("/cases/"+env.Case.ID+"/evidences", "ph-cube", "Add evidence")
			</div>
		}
	}
}

// fullscreen is the app shell: a sidebar pinned to the viewport (via
// drawer-open's own sticky positioning) next to a content column capped at
// h-screen. drawer-content and main form the flex chain that makes that cap
// real — min-h-0 at each step stops a tall child from stretching its parent
// past the viewport — so main is the one place that scrolls, instead of the
// document growing past 100vh and dragging the "fixed" sidebar down with it.
templ fullscreen(env Env, title string) {
	<div class="drawer drawer-open h-screen">
		<input id="sidebar-toggle" type="checkbox" class="drawer-toggle" checked/>
		<div class="drawer-content flex flex-col min-h-0">
			<div id="errors"></div>
			<main class="flex flex-col grow min-h-0 max-w-full overflow-y-auto">
				{ children... }
			</main>
		</div>
		<div class="drawer-side is-drawer-close:overflow-visible">
			@sidebar(env, title)
		</div>
	</div>
}

type navbarConfig struct {
	preTitle    templ.Component
	preJoin     templ.Component
	preButtons  templ.Component
	titleIcon   string
	hideImport  bool
	hideExport  bool
	hideRefresh bool
	hideAdd     bool
	hideSearch  bool
}

type navbarOption func(*navbarConfig)

func applynavOptions(opts []navbarOption) navbarConfig {
	cfg := navbarConfig{}
	for _, opt := range opts {
		opt(&cfg)
	}
	return cfg
}

func navPreButtons(c templ.Component) navbarOption {
	return func(nc *navbarConfig) { nc.preButtons = c }
}

func navPreTitle(c templ.Component) navbarOption { return func(nc *navbarConfig) { nc.preTitle = c } }
func navPreJoin(c templ.Component) navbarOption  { return func(nc *navbarConfig) { nc.preJoin = c } }
func navTitleIcon(icon string) navbarOption      { return func(nc *navbarConfig) { nc.titleIcon = icon } }
func navHideImport() navbarOption                { return func(nc *navbarConfig) { nc.hideImport = true } }
func navHideExport() navbarOption                { return func(nc *navbarConfig) { nc.hideExport = true } }
func navHideRefresh() navbarOption               { return func(nc *navbarConfig) { nc.hideRefresh = true } }
func navHideAdd() navbarOption                   { return func(nc *navbarConfig) { nc.hideAdd = true } }
func navHideSearch() navbarOption                { return func(nc *navbarConfig) { nc.hideSearch = true } }
func navSettings() navbarOption                  { return navPreTitle(navSettingsTitle()) }

templ navSettingsTitle() {
	<li>
		<a href="/settings" class="text-base-content/60 font-normal hover:text-base-content transition-colors">
			<i class="ph ph-6 ph-gear-six"></i>
			Settings
		</a>
	</li>
}

// navbar is the page header: a breadcrumb trail that doubles as the page
// title, and the section's controls. The trail carries the case switcher, so
// the one control that changes context sits at the top of every page. It's
// one text size throughout — ancestors and the current page are told apart
// by weight and ink, not by size.
templ navbar(env Env, title string, opts ...navbarOption) {
	{{ cfg := applynavOptions(opts) }}
	<nav class="navbar bg-base-100">
		<h1 class="breadcrumbs flex-1 text-2xl font-semibold">
			<ul>
				if cfg.preTitle != nil {
					@cfg.preTitle
				}
				if env.Case.ID != "" {
					<li>
						<a
							href={ "/cases/switch?from=" + env.Case.ID + "&to=" + SectionSuffix(env.Route, env.Case.ID) }
							up-layer="new popup"
							up-size="grow"
							up-history="false"
							title="Switch to another case"
							class="text-muted"
						>
							<i class="ph ph-6 ph-briefcase"></i>
							{ env.Case.Name }
						</a>
					</li>
				}
				<li>
					<span>
						if cfg.titleIcon != "" {
							<i class={ "ph ph-6 ph-" + cfg.titleIcon }></i>
						}
						{ title }
						if env.Case.IsTemplate {
							<a href="/settings/case-templates/" class="badge badge-outline badge-sm" title="Manage case templates">Template</a>
						}
					</span>
				</li>
			</ul>
		</h1>
		<div class="flex-none">
			if !cfg.hideSearch {
				<label class="w-72 input">
					<i class="ph ph-magnifying-glass text-muted"></i>
					<input type="search" name="search" class="search grow" placeholder="Filter rows ..."/>
				</label>
			}
			if cfg.preJoin != nil {
				@cfg.preJoin
			}
			<div class="join" role="group" up-autosubmit>
				if cfg.preButtons != nil {
					@cfg.preButtons
				}
				if uri, ok := env.Allowed("POST", env.Route+"import/csv"); ok && !cfg.hideImport {
					<a class="join-item btn" href={ uri } up-layer="new drawer" up-accept-location={ env.Route }>
						<i class="ph ph-5 ph-sort-ascending"></i> Import
					</a>
				}
				if uri, ok := env.Allowed("GET", env.Route+"export/csv"); ok && !cfg.hideExport {
					<a class="join-item btn" href={ uri }>
						<i class="ph ph-5 ph-sort-descending"></i> Export
					</a>
				}
				if uri, ok := env.Allowed("GET", env.Route); ok && !cfg.hideRefresh {
					<a class="join-item btn" href={ uri } up-target="#list">
						<i class="ph ph-5 ph-arrows-clockwise"></i> Refresh
					</a>
				}
				if uri, ok := env.Allowed("POST", env.Route+"new"); ok && !cfg.hideAdd {
					<a class="join-item btn btn-primary" href={ uri } up-layer="new drawer" up-accept-location={ env.Route }>
						<i class="ph ph-5 ph-plus"></i> Add
					</a>
				}
			</div>
		</div>
	</nav>
}

templ sidebarLink(url string, title string, icon string, page string) {
	{{ active := title == page }}
	<li>
		<a href={ url } class={ "is-drawer-close:tooltip is-drawer-close:tooltip-right", fp.If(active, "menu-active", "") } data-tip={ title }>
			<i class={ "ph ph-6 ph-" + icon, templ.KV("text-muted", !active) }></i>
			<span class="is-drawer-close:hidden">{ title }</span>
		</a>
	</li>
}

// themeToggleIcon picks the icon reflecting the current server-rendered theme
// (decision 6): sun for light, moon for dark, circle-half for auto. The
// client-side toggle (dagobert.js) swaps this icon itself when cycling state.
func themeToggleIcon(theme string) string {
	switch theme {
	case "dagobert":
		return "ph-sun"
	case "dagobert-dark":
		return "ph-moon"
	default:
		return "ph-circle-half"
	}
}

// sidebar is the collapsible rail: the brand mark, then the sections grouped
// under headings — workspace, the active case (named, so the rail says which
// one), analysis, account. Collapsed, it shows icons with a hover tooltip;
// expanded, it shows the label too. See daisyUI's own "responsive collapsible
// icon-only drawer sidebar" recipe (is-drawer-close:/is-drawer-open:), driven
// by the #sidebar-toggle checkbox declared alongside the drawer in list()/
// fullscreen().
templ sidebar(env Env, title string) {
	<aside class="is-drawer-close:w-14 is-drawer-open:w-64 bg-base-100 flex flex-col items-start min-h-full">
		<div class="p-3 flex items-center justify-center w-full">
			@medallion("is-drawer-close:w-8 is-drawer-open:w-24")
		</div>
		<ul class="menu w-full gap-px">
			<li class="menu-title is-drawer-close:hidden">Workspace</li>
			@sidebarLink("/", "Cases", "briefcase", title)
			@sidebarLink("/dashboard", "Dashboard", "chart-bar", title)
		</ul>
		if env.Case.ID != "" {
			<ul class="menu w-full gap-px">
				<li class="menu-title is-drawer-close:hidden">Investigation</li>
				@sidebarLink("/cases/"+env.Case.ID+"/summary/", "Summary", "house", title)
				if !env.Case.IsTemplate {
					@sidebarLink("/cases/"+env.Case.ID+"/events/", "Timeline", "clock", title)
					@sidebarLink("/cases/"+env.Case.ID+"/assets/", "Assets", "desktop", title)
					@sidebarLink("/cases/"+env.Case.ID+"/malware/", "Malware/Tools", "bug-beetle", title)
					@sidebarLink("/cases/"+env.Case.ID+"/indicators/", "Indicators", "fingerprint", title)
					@sidebarLink("/cases/"+env.Case.ID+"/evidences/", "Evidences", "cube", title)
				}
				@sidebarLink("/cases/"+env.Case.ID+"/tasks/", "Tasks", "check-square", title)
				@sidebarLink("/cases/"+env.Case.ID+"/notes/", "Notes", "note", title)
			</ul>
			if !env.Case.IsTemplate {
				<ul class="menu w-full gap-px">
					<li class="menu-title is-drawer-close:hidden">Analysis</li>
					@sidebarLink("/cases/"+env.Case.ID+"/vis/network", "Graph", "share-network", title)
					@sidebarLink("/cases/"+env.Case.ID+"/vis/mitre", "Techniques", "compass", title)
					<li>
						<a href={ "/cases/" + env.Case.ID + "/reports" } up-layer="new drawer" class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Report">
							<i class="ph ph-6 ph-file-arrow-down text-muted"></i>
							<span class="is-drawer-close:hidden">Report</span>
						</a>
					</li>
				</ul>
			}
		}
		<div class="grow"></div>
		<ul class="menu w-full gap-px">
			if _, ok := env.Allowed("GET", "/settings/"); ok {
				@sidebarLink("/settings/", "Settings", "gear-six", title)
			}
			<li>
				<a data-theme-toggle title="Toggle theme" class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Toggle theme">
					<i class={ "ph ph-6 text-muted " + themeToggleIcon(themeFromContext(ctx)) }></i>
					<span class="is-drawer-close:hidden">Theme</span>
				</a>
			</li>
			<li>
				<a href="/auth/changepassword" up-layer="new drawer" class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Password">
					<i class="ph ph-6 ph-key text-muted"></i>
					<span class="is-drawer-close:hidden">Password</span>
				</a>
			</li>
			<li>
				<a href="/auth/logout" class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Sign out">
					<i class="ph ph-6 ph-sign-out text-muted"></i>
					<span class="is-drawer-close:hidden">Sign out</span>
				</a>
			</li>
		</ul>
	</aside>
}

templ formatTime(t model.Time) {
	if t.IsZero() {
		-
	} else {
		<span class="font-mono text-xs text-nowrap">{ t.Format("2006-01-02 15:04:05") } <span class="text-muted">{ t.Format("Z07:00") }</span></span>
	}
}

// Row actions are ghost buttons at btn-xs: anything larger sets the row height
// itself (see --row-h). A DELETE opens a modal rather than a drawer, because it
// answers with the confirm dialog.
templ actionBtn(env Env, method, url string) {
	if _, ok := env.Allowed(method, url); ok {
		<a class="join-item btn btn-xs btn-ghost text-nowrap" href={ url } up-method={ method } up-layer={ fp.If(method == "DELETE", "new modal", "new drawer") } up-accept-location={ env.Route }>
			{ children... }
		</a>
	}
}

templ externalBtn(url string, label string) {
	<a class="join-item btn btn-xs btn-ghost" href={ url } target="_blank">
		{ label }
		{ children... }
	</a>
}

templ defaultActionBtns(env Env, url string) {
	@actionBtn(env, "GET", url) {
		<i class="ph ph-5 ph-pencil-simple"></i>
	}
	@actionBtn(env, "DELETE", url) {
		<i class="ph ph-5 ph-trash"></i>
	}
}

// findValue looks a raw stored value up in its (user-editable) list. Values
// imported before the list defined them come back with the raw name and no
// state, so they still render rather than vanishing from the grid.
func findValue(list []model.ValueListItem, value string) model.ValueListItem {
	for _, x := range list {
		if x.Name == value {
			return x
		}
	}
	return model.ValueListItem{Name: value}
}

templ statusDot(list []model.ValueListItem, value string) {
	{{ x := findValue(list, value) }}
	if x.Name != "" {
		<span class="inline-flex items-center gap-2">
			<span class={ "status", fp.If(x.State == "error", "status-error", "status-neutral") }></span>
			<span class={ templ.KV("text-error", x.State == "error") }>{ x.Name }</span>
		</span>
	}
}

templ valueMono(list []model.ValueListItem, value string) {
	{{ x := findValue(list, value) }}
	if x.Name != "" {
		<span class={ templ.KV("text-error", x.State == "error") }>{ x.Name }</span>
	}
}

templ valueIcon(list []model.ValueListItem, value string) {
	{{ x := findValue(list, value) }}
	if x.Name != "" {
		<span class={ "flex items-center gap-2" + fp.If(x.State != "", " text-"+x.State, "") }>
			if x.Icon != "" {
				<i class={ "ph ph-5 " + x.Icon } title={ x.Name }></i>
			}
			{ children... }
		</span>
	}
}

// typeIcon renders only the record type's icon, with the type name as its
// tooltip — for readouts where the type is context and the value is the point.
templ typeIcon(list []model.ValueListItem, value string) {
	{{ x := findValue(list, value) }}
	if x.Icon != "" {
		<i class={ "ph ph-5 shrink-0 text-muted " + x.Icon } title={ x.Name }></i>
	} else {
		<i class="ph ph-5 ph-dot-outline shrink-0 text-muted" title={ x.Name }></i>
	}
}

// emptyTable carries the actions themselves rather than pointing at the
// toolbar — the same routes, gated by the same ACL checks.
templ emptyTable(env Env, voice string, desc string) {
	<tr>
		<td colspan="100" class="text-center py-16 px-8">
			@medallion("medallion w-32 h-32 mx-auto")
			if voice != "" {
				<section class="text-2xl font-semibold">{ voice }</section>
			}
			if desc != "" {
				<section class="text-sm text-muted max-w-md mx-auto leading-relaxed">{ desc }</section>
			} else {
				<section class="text-sm text-muted">Nothing recorded yet.</section>
			}
			@emptyActions(env)
		</td>
	</tr>
}

// emptyActions offers whatever the user is actually allowed to do here. The
// import route differs by section — most use import/csv, indicators has a
// format menu one level up — so both are probed.
templ emptyActions(env Env) {
	{{ addURI, canAdd := env.Allowed("POST", env.Route+"new") }}
	{{ csvURI, canCSV := env.Allowed("POST", env.Route+"import/csv") }}
	{{ impURI, canImport := env.Allowed("POST", env.Route+"import") }}
	if canAdd || canCSV || canImport {
		<div class="flex gap-2 justify-center mt-6">
			if canAdd {
				<a class="btn btn-sm btn-primary" href={ addURI } up-layer="new drawer" up-accept-location={ env.Route }>
					<i class="ph ph-5 ph-plus"></i> Add
				</a>
			}
			if canCSV {
				<a class="btn btn-sm btn-ghost" href={ csvURI } up-layer="new drawer" up-accept-location={ env.Route }>
					<i class="ph ph-5 ph-sort-ascending"></i> Import CSV
				</a>
			} else if canImport {
				<a class="btn btn-sm btn-ghost" href={ impURI + "/csv" } up-layer="new drawer" up-accept-location={ env.Route }>
					<i class="ph ph-5 ph-sort-ascending"></i> Import CSV
				</a>
			}
		</div>
	}
}

templ fabButton(baseUrl string, icon string, title string) {
	<div class="tooltip tooltip-left" data-tip={ title }>
		<a class="btn btn-circle" href={ baseUrl + "/new" } up-layer="new drawer" up-accept-location={ baseUrl } data-on-accepted="reload-list">
			<i class={ "ph ph-6 " + icon }></i>
		</a>
	</div>
}
