package views

import (
	"fmt"
	"strconv"

	"github.com/sprungknoedl/dagobert/internal/model"
)

// ConfirmDialog is a plain daisyUI modal body: the question, then the two
// answers — a two-button question doesn't need a fixed head/body/foot frame.
//
// It opens in a modal rather than a drawer — two lines of text in a
// full-height drawer is mostly empty column.
templ ConfirmDialog(dst string, opts ...ConfirmOption) {
	{{ cfg := applyConfirmOptions(opts) }}
	@layout() {
		<main>
			<div class="flex items-start gap-4">
				<i class="ph ph-trash text-2xl text-error" aria-hidden="true"></i>
				<div class="grow min-w-0">
					<h1 class="text-xl font-semibold leading-tight">Delete this record?</h1>
					<p class="text-sm text-muted mt-2">This is permanent and cannot be undone.</p>
				</div>
			</div>
			<div class="modal-action">
				if cfg.commitInParent {
					<a href={ dst } class="btn btn-error" up-follow up-method="delete" up-layer="parent" up-target="main">Delete</a>
				} else {
					<a href={ dst } class="btn btn-error" up-follow up-method="delete">Delete</a>
				}
				<a class="btn btn-ghost" up-dismiss>Cancel</a>
			</div>
		</main>
	}
}

type confirmConfig struct {
	commitInParent bool
}

type ConfirmOption func(*confirmConfig)

func applyConfirmOptions(opts []ConfirmOption) confirmConfig {
	cfg := confirmConfig{}
	for _, opt := range opts {
		opt(&cfg)
	}
	return cfg
}

// CommitInParent renders the delete's response into the layer beneath the
// confirm instead of the confirm's own, which peels the confirm away as the view
// underneath refreshes.
//
// It is for confirms opened from inside another overlay — the comment delete
// sits above the comments drawer, and its response is that drawer's refreshed
// list. Grid deletes don't need it: their redirect matches the opening link's
// up-accept-location, and #list refreshes itself through up-hungry.
func CommitInParent() ConfirmOption {
	return func(cfg *confirmConfig) { cfg.commitInParent = true }
}

// The import dialogs stay drawers — a file to choose and, for an archive, a
// manifest to read — and take the same fixed head and foot as every other form.
templ ImportDialog() {
	@layout() {
		<main class="form-sheet">
			<form method="post" up-submit enctype="multipart/form-data">
				<header class="form-head">
					<div class="grow min-w-0">
						<h1 class="text-2xl font-semibold leading-none">Import from CSV</h1>
					</div>
					<a class="btn btn-ghost btn-square" up-dismiss aria-label="Close">
						<i class="ph ph-6 ph-x"></i>
					</a>
				</header>
				<div class="form-body">
					<p class="flex items-center gap-2 text-sm text-muted">
						<i class="ph ph-5 ph-info"></i>
						Please note, that dagobert will attempt to deduplicate entries.
					</p>
					<input name="file" class="file-input w-full" type="file"/>
				</div>
				<footer class="form-foot">
					<button type="submit" class="btn btn-neutral">Save</button>
					<a class="btn btn-ghost" up-dismiss>Cancel</a>
				</footer>
			</form>
		</main>
	}
}

// ImportRowError is one collected row failure from ImportCSV, keyed by the
// CSV's actual line number (row 1 is the header, so the first data row is 2).
type ImportRowError struct {
	Row     int
	Message string
}

// ImportErrors reports every row that failed an atomic CSV import in one
// screen — nothing committed, so there is no form to redisplay inline the
// way a regular 422 does.
templ ImportErrors(errs []ImportRowError) {
	@layout() {
		<main>
			<div class="flex items-start gap-4">
				<i class="ph ph-warning-circle text-2xl text-error" aria-hidden="true"></i>
				<div class="grow min-w-0">
					<h1 class="text-xl font-semibold leading-tight">Import failed</h1>
					<p class="text-sm text-muted mt-2">Nothing was imported. Fix the rows below and re-upload.</p>
				</div>
			</div>
			<ul class="list-disc ml-4 text-sm">
				for _, e := range errs {
					<li>{ fmt.Sprintf("Row %d: %s", e.Row, e.Message) }</li>
				}
			</ul>
			<div class="modal-action">
				<a class="btn btn-ghost" up-dismiss>Close</a>
			</div>
		</main>
	}
}

templ ImportArchiveDialog() {
	@layout() {
		<main class="form-sheet">
			<form method="post" up-submit enctype="multipart/form-data">
				<header class="form-head">
					<div class="grow min-w-0">
						<h1 class="text-2xl font-semibold leading-none">Import case from archive</h1>
					</div>
					<a class="btn btn-ghost btn-square" up-dismiss aria-label="Close">
						<i class="ph ph-6 ph-x"></i>
					</a>
				</header>
				<div class="form-body">
					<p class="flex items-start gap-2 text-sm text-muted">
						<i class="ph ph-5 ph-info"></i>
						<span>Select a <span class="font-mono">.dagobert.zip</span> archive. The case is recreated with its original IDs — importing a case that already exists will fail.</span>
					</p>
					<input name="file" class="file-input w-full" type="file" accept=".zip"/>
				</div>
				<footer class="form-foot">
					<button type="submit" class="btn btn-neutral">Continue</button>
					<a class="btn btn-ghost" up-dismiss>Cancel</a>
				</footer>
			</form>
		</main>
	}
}

templ ImportArchiveConfirm(m model.Manifest, token string) {
	@layout() {
		<main class="form-sheet">
			// On commit the server redirects to the new case summary; render it on
			// the root layer (closing this drawer) instead of inside the overlay.
			<form method="post" up-submit up-layer="root" up-target="main">
				<input type="hidden" name="token" value={ token }/>
				<input type="hidden" name="confirm" value="yes"/>
				<header class="form-head">
					<div class="grow min-w-0">
						<h1 class="text-2xl font-semibold leading-none truncate">Import this case?</h1>
						<div class="text-xs text-muted mt-2">{ "№ " + m.OriginalCaseID }</div>
					</div>
					<a class="btn btn-ghost btn-square" up-dismiss aria-label="Close">
						<i class="ph ph-6 ph-x"></i>
					</a>
				</header>
				<div class="form-body">
					@fieldset("Provenance") {
						<dl class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-2 text-sm">
							<dt class="fieldset-legend self-center">Source instance</dt>
							<dd>{ m.SourceInstance }</dd>
							<dt class="fieldset-legend self-center">Exported by</dt>
							<dd>{ m.ExportedBy }</dd>
							<dt class="fieldset-legend self-center">Exported at</dt>
							<dd class="font-mono text-xs">{ m.ExportedAt.Format("2006-01-02 15:04 MST") }</dd>
							<dt class="fieldset-legend self-center">Includes files</dt>
							<dd>{ strconv.FormatBool(m.IncludesBinaries) }</dd>
						</dl>
					}
					@fieldset("Contents") {
						<table class="table">
							<tbody>
								for _, key := range []string{"assets", "events", "indicators", "malware", "evidences", "notes", "tasks", "comments"} {
									<tr>
										<td class="capitalize">{ key }</td>
										<td class="text-right tabular-nums">{ strconv.Itoa(m.Counts[key]) }</td>
									</tr>
								}
							</tbody>
						</table>
					}
					if len(m.Warnings) > 0 {
						<div class="alert alert-warning alert-soft text-sm" role="alert">
							<div>
								<p class="mb-1">Export warnings</p>
								<ul class="list-disc ml-4">
									for _, warn := range m.Warnings {
										<li>{ warn }</li>
									}
								</ul>
							</div>
						</div>
					}
					<p class="flex items-start gap-2 text-sm text-muted">
						<i class="ph ph-5 ph-info"></i>
						<span>Record values referencing customizable valueLists (classifications, types, TLP, …) are imported as-is. Values this instance does not define will show as uncustomized — reconcile your valueLists if needed.</span>
					</p>
				</div>
				<footer class="form-foot">
					<button type="submit" class="btn btn-neutral">Import case</button>
					<a class="btn btn-ghost" up-dismiss>Cancel</a>
				</footer>
			</form>
		</main>
	}
}

// Toasts: same markup as showToast in dagobert.js, which renders the success
// case client-side. Only the failure case takes the severe (error) hue —
// warning renders in the same alert-warning class, but the theme maps warning
// to plain ink rather than a hue, so it still degrades to neutral.
templ ToastError(err error) {
	@layout() {
		<section id="errors" class="toast toast-top toast-center z-20">
			<div class="alert alert-error" role="alert" data-remove-self>
				<i class="ph ph-x-circle text-xl"></i>
				<div>
					<div class="font-semibold">Failed</div>
					<div class="text-sm">{ err.Error() }</div>
				</div>
			</div>
		</section>
	}
}

templ ToastWarning(err error) {
	@layout() {
		<section id="errors" class="toast toast-top toast-center z-20">
			<div class="alert alert-warning" role="alert" data-remove-self>
				<i class="ph ph-warning-circle text-xl"></i>
				<div>
					<div class="font-semibold">Not recorded</div>
					<div class="text-sm">{ err.Error() }</div>
				</div>
			</div>
		</section>
	}
}
